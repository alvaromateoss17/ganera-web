# Variables de entorno de la landing de Ganera (ganera.es).
# Copia este archivo a .env.local para desarrollo y configura los valores
# reales en Vercel → Project → Settings → Environment Variables.
#
# NUNCA commitees valores reales: .env* está en .gitignore.

# ── Stripe ────────────────────────────────────────────────
# Clave secreta. Solo servidor: jamás llega al navegador.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# Price ID de cada plan y periodo (Stripe → Catálogo de productos → Precios).
# Los planes son los de _partials/precios.json: Base, Gestión y Plus.
STRIPE_PRICE_BASE_MENSUAL=price_xxxxxxxxxxxx
STRIPE_PRICE_BASE_ANUAL=price_xxxxxxxxxxxx
STRIPE_PRICE_GESTION_MENSUAL=price_xxxxxxxxxxxx
STRIPE_PRICE_GESTION_ANUAL=price_xxxxxxxxxxxx
STRIPE_PRICE_PLUS_MENSUAL=price_xxxxxxxxxxxx
STRIPE_PRICE_PLUS_ANUAL=price_xxxxxxxxxxxx

# Complemento opcional GaneraAI (49 €/mes). Se añade como segunda línea si la
# petición a /api/checkout lleva { ganerai: true }. Si falta, se ignora.
STRIPE_PRICE_GANERAI=price_xxxxxxxxxxxx

# Opcional: ID del Tax Rate del IVA 21 % creado en Stripe.
# Si se deja vacío, no se aplica ningún impuesto automático.
STRIPE_TAX_RATE_ID=

# Días de prueba. Por defecto 15.
STRIPE_TRIAL_DAYS=15

# ── Interruptor del checkout ──────────────────────────────
# false (por defecto): los CTA de los planes mantienen su comportamiento
#   actual (enlace a /prueba-15-dias) y /api/checkout responde 503.
# true: los CTA abren Stripe Checkout.
# No existe prefijo público (NEXT_PUBLIC_/VITE_) porque la web es HTML estático
# sin paso de compilación: el navegador lo lee de GET /api/config.
CHECKOUT_ENABLED=false

# ── URLs ──────────────────────────────────────────────────
PUBLIC_SITE_URL=https://ganera.es
APP_LOGIN_URL=https://app.ganera.es/login

# ── Avisos de los formularios (ya en uso) ─────────────────
RESEND_API_KEY=
LEADS_TO_EMAIL=agroganera@gmail.com
LEADS_FROM_EMAIL=Ganera <onboarding@resend.dev>
