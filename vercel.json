{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/nosotros/equipo",
      "destination": "/nosotros#equipo",
      "permanent": true
    },
    {
      "source": "/nosotros/valores",
      "destination": "/nosotros#mision",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
